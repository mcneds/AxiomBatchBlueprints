{
  "schemaVersion": 1,
  "id": "axiombatchbp",
  "version": "${version}",
  "name": "Axiom Batch Blueprints",
  "description": "Batch-converts Sponge .schem files into native Axiom .bp files using Axiom's own thumbnail renderer.",
  "authors": ["OpenAI"],
  "license": "CC0-1.0",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.aiden.axiombatch.AxiomBatchBlueprintsClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*",
    "axiom": "*"
  }
}
