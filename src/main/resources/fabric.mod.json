{
  "schemaVersion": 1,
  "id": "axiombatchbp",
  "version": "${version}",
  "name": "Axiom Batch Blueprints",
  "description": "Converts .schem files to Axiom .bp blueprints.",
  "authors": ["mcneds"],
  "license": "CC0-1.0",
  "icon": "assets/axiombatchbp/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.aiden.axiombatch.AxiomBatchBlueprintsClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "${minecraft_dependency}",
    "java": ">=25",
    "fabric-api": "*",
    "axiom": "*"
  }
}
